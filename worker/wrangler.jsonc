{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bank-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve only from your own (Access-protected) custom domain, never from *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "kv_namespaces": [
    // Create with `npx wrangler kv namespace create TOKENS` and paste the id here.
    { "binding": "TOKENS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "TRUELAYER_ENV": "live",
    // Cloudflare Zero Trust team name (the <team> in <team>.cloudflareaccess.com).
    "ACCESS_TEAM_DOMAIN": "",
    // Audience (AUD) tag of the Access application that protects this Worker.
    "ACCESS_AUD": ""
  }
  // Add your route, e.g.
  // "routes": [{ "pattern": "bank-mcp.example.com", "custom_domain": true }]
  // Secrets (set with `wrangler secret put`): TRUELAYER_CLIENT_ID, TRUELAYER_CLIENT_SECRET
}
